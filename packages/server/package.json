{
  "name": "@subactid/server",
  "version": "0.1.0",
  "description": "Subact ID for tool servers: validate task tokens against the control plane, enforce per-route scope, introspect high-risk routes, and log who acted for whom. Framework-agnostic, with Express and Fastify adapters.",
  "license": "Apache-2.0",
  "author": {
    "name": "Nikola Živković PR Agencija za programerske usluge Novi Sad",
    "email": "support@subactid.com",
    "url": "https://subactid.com"
  },
  "homepage": "https://github.com/subactid/subactid-sdk/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/subactid/subactid-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subactid/subactid-sdk",
    "directory": "packages/server"
  },
  "keywords": [
    "subactid",
    "oauth",
    "token-exchange",
    "rfc8693",
    "ai-agents",
    "delegation",
    "jwt",
    "express",
    "fastify"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "express": "5.2.1",
    "fastify": "5.12.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
