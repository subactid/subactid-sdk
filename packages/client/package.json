{
  "name": "@subactid/client",
  "version": "0.1.0",
  "description": "Client for the Subact ID agent identity control plane: token exchange, proactive refresh and task grants.",
  "license": "Apache-2.0",
  "author": {
    "name": "Nikola Živković PR Agencija za programerske usluge Novi Sad",
    "email": "support@subactid.com",
    "url": "https://subactid.com"
  },
  "homepage": "https://github.com/subactid/subactid-sdk/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/subactid/subactid-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subactid/subactid-sdk",
    "directory": "packages/client"
  },
  "keywords": [
    "subactid",
    "oauth",
    "token-exchange",
    "rfc8693",
    "ai-agents",
    "delegation",
    "agent-identity"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
