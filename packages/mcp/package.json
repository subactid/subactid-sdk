{
  "name": "@subactid/mcp",
  "version": "0.1.0",
  "description": "Subact ID for MCP servers: validate task tokens against the control plane's JWKS, enforce per-tool scope, introspect high-risk tools, and log who acted for whom on every call.",
  "license": "Apache-2.0",
  "author": {
    "name": "Nikola Živković PR Agencija za programerske usluge Novi Sad",
    "email": "support@subactid.com",
    "url": "https://subactid.com"
  },
  "homepage": "https://github.com/subactid/subactid-sdk/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/subactid/subactid-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/subactid/subactid-sdk",
    "directory": "packages/mcp"
  },
  "keywords": [
    "subactid",
    "oauth",
    "token-exchange",
    "rfc8693",
    "ai-agents",
    "delegation",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0 <2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  },
  "dependencies": {
    "@subactid/server": "workspace:*"
  }
}
